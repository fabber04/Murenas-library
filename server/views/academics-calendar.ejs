<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Murena's Students Library</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main class="container" style="margin: 2rem auto; padding: 0 1rem;">
      <h1 class="mt-2"><%= title %></h1>

      <% if (calendarDoc) { %>
        <section class="card">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
              <h2 style="margin: 0 0 0.5rem 0;"><%= calendarDoc.title %></h2>
              <p class="text-muted" style="margin: 0;">
                Published: <%= new Date(calendarDoc.createdAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </p>
            </div>
            <a href="/uploads/<%= calendarDoc.fileName %>" download="<%= calendarDoc.originalName %>" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Calendar
            </a>
          </div>
          
          <!-- PDF Viewer -->
          <div style="width: 100%; margin: 2rem 0; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; background: #f8fafc;">
            <div style="padding: 1rem; background: #fff; border-bottom: 1px solid #e2e8f0;">
              <p class="text-muted" style="margin: 0; font-size: 0.9rem;">
                <strong>View Calendar:</strong> Scroll to view the full calendar below, or download for offline access.
              </p>
            </div>
            <div style="width: 100%; min-height: 800px; position: relative;">
              <embed 
                src="/uploads/<%= calendarDoc.fileName %>#toolbar=1&navpanes=1&scrollbar=1" 
                type="application/pdf" 
                style="width: 100%; height: 800px; border: none; display: block;"
                title="Academic Calendar PDF">
              <iframe 
                src="/uploads/<%= calendarDoc.fileName %>#toolbar=1&navpanes=1&scrollbar=1" 
                style="width: 100%; height: 800px; border: none; display: block; position: absolute; top: 0; left: 0;"
                title="Academic Calendar PDF Viewer"
                type="application/pdf">
                <p style="padding: 2rem; text-align: center; color: #64748b;">
                  Your browser does not support PDF viewing. 
                  <a href="/uploads/<%= calendarDoc.fileName %>" download="<%= calendarDoc.originalName %>" class="btn btn-primary">Download the calendar</a> to view it.
                </p>
              </iframe>
            </div>
          </div>
          
          <div style="margin-top: 1.5rem; padding: 1.5rem; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p class="text-muted" style="margin: 0 0 1rem 0;">
              <strong>Note:</strong> This is the official revised academic calendar. Please download and keep a copy for your records.
            </p>
            <p style="margin: 0; color: #64748b;">
              File: <code style="background: #e2e8f0; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.9rem;"><%= calendarDoc.originalName %></code>
            </p>
          </div>
        </section>
      <% } else { %>
        <section class="card">
          <p class="text-muted">Academic calendar document will be available here once it's been uploaded and approved.</p>
          <p class="text-muted">Please check back later or contact the Registrar's Office for the current academic calendar.</p>
        </section>
      <% } %>
    </main>
  </body>
</html>
