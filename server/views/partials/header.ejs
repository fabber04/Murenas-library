<style>
  /* Header interactions */
  #menu-toggle:hover,
  button[onclick*="history.back"]:hover {
    background: rgba(255,255,255,0.02);
    transform: translateY(-1px);
  }

  #dropdown-menu a:hover {
    background: #f1f5f9;
    color: #2563eb;
    padding-left: 1.5rem;
  }

  #dropdown-menu > div > a:hover {
    padding-left: 2rem;
  }

  /* Left sidebar styles */
  .left-sidebar { display: none; }
  .left-sidebar a { color: #e6eef8; text-decoration: none; }
  .left-sidebar nav a { color: #cbd5e1; }

  /* Small screens: ensure menu stretches full width */
  @media (max-width: 640px) {
    #dropdown-menu { left: -0.5rem; right: -0.5rem; min-width: auto; border-radius: 8px; }
  }

  /* Large screens: show sidebar and shift main content */
  @media (min-width: 992px) {
    .left-sidebar { display:block; position:fixed; left:0; top:0; height:100vh; width:260px; background:#071029; color:#e6eef8; padding:1.25rem; box-shadow:4px 0 24px rgba(2,6,23,0.12); z-index:1000; overflow:auto; }
    body > main { margin-left: 300px; transition: margin-left 150ms ease; }
    #menu-toggle { display: none !important; }
    #dropdown-menu { display: none !important; }
  }
</style>

<script>
  (function(){
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('dropdown-menu');
    if (!toggle || !menu) return;

    function openMenu() {
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('no-scroll');
      const first = menu.querySelector('a[role="menuitem"]');
      if (first) first.focus();
    }

    function closeMenu() {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('no-scroll');
      try { toggle.focus(); } catch (e){}
    }

    toggle.addEventListener('click', function(e){
      e.stopPropagation();
      if (menu.classList.contains('open')) closeMenu(); else openMenu();
    });

    // Close on outside click or ESC
    document.addEventListener('click', function(event){
      if (!menu.contains(event.target) && !toggle.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // Close menu after selecting an item
    menu.querySelectorAll('a[role="menuitem"]').forEach(link => {
      link.addEventListener('click', function() { closeMenu(); });
    });
  })();
</script>
