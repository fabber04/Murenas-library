<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Exam Materials - Murena's Students Library</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main style="max-width: 1200px; margin: 2rem auto; padding: 0 1rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>Exam Materials</h1>
        <a href="/materials/submit" style="padding: 0.5rem 1rem; background: #007bff; color: white; text-decoration: none; border-radius: 4px;">Upload Material</a>
      </div>

      <div style="margin-bottom: 2rem; padding: 1rem; background: #f5f5f5; border-radius: 4px;">
        <form method="get" action="/materials" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <input type="text" name="query" placeholder="Search by title or course..." value="<%= query || '' %>" />
          <select name="type">
            <option value="">All Types</option>
            <option value="notes" <%= type === 'notes' ? 'selected' : '' %>>Notes</option>
            <option value="solution" <%= type === 'solution' ? 'selected' : '' %>>Solutions</option>
            <option value="exam_paper" <%= type === 'exam_paper' ? 'selected' : '' %>>Exam Papers</option>
            <option value="textbook" <%= type === 'textbook' ? 'selected' : '' %>>Textbooks</option>
          </select>
          <input type="number" name="year" placeholder="Year" value="<%= year || '' %>" />
          <button type="submit">Filter</button>
        </form>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <strong>Error:</strong> <%= error %>
        </div>
      <% } %>

      <div id="materials-list">
        <% if (typeof materials !== 'undefined' && materials.length > 0) { %>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
            <% materials.forEach(function(material) { %>
              <div class="card" style="display: flex; flex-direction: column;">
                <div style="flex: 1;">
                  <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem;">
                    <%= material.title %>
                  </h3>
                  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                    <span style="background: #e3f2fd; color: #1976d2; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.875rem; font-weight: 600;">
                      <%= material.type.replace('_', ' ').toUpperCase() %>
                    </span>
                    <span style="background: #f5f5f5; color: #666; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.875rem;">
                      <%= material.courseId %>
                    </span>
                    <span style="background: #f5f5f5; color: #666; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.875rem;">
                      <%= material.year %>
                    </span>
                  </div>
                  <p style="color: #666; font-size: 0.875rem; margin: 0.5rem 0;">
                    <small><%= material.originalName %></small>
                  </p>
                  <p style="color: #999; font-size: 0.75rem; margin: 0.5rem 0 0 0;">
                    Uploaded: <%= new Date(material.createdAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                  </p>
                </div>
                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
                  <a href="/uploads/<%= material.filePath.split('/').pop() %>" 
                     download="<%= material.originalName %>" 
                     class="btn btn-primary" 
                     style="width: 100%; text-align: center; display: block;">
                    Download
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="card" style="text-align: center; padding: 3rem 2rem;">
            <p style="color: #666; margin: 0;">
              <% if (query || type || year) { %>
                No materials found matching your search criteria.
              <% } else { %>
                No materials available yet. Be the first to <a href="/materials/submit">upload materials</a>!
              <% } %>
            </p>
          </div>
        <% } %>
      </div>
    </main>
  </body>
</html>
